{
  "name": "crypto-perp-heat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gen-assets.mjs && tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node scripts/gen-assets.mjs && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "backtest": "esbuild backtest/run.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/backtest.mjs && node node_modules/.cache/backtest.mjs"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.3",
    "lightweight-charts": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "https-proxy-agent": "^9.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
